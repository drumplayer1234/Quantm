{
  "name": "quantm",
  "productName": "Quantm",
  "version": "1.0.0",
  "description": "Quantm",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "license": "GPL-3.0",
  "build": {
    "appId": "app.quantm.desktop",
    "productName": "Quantm",
    "files": [
      "main.js",
      "preload.js",
      "discord.js",
      "src/**/*",
      "build/icon.png",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "appId": "Quantm"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "description": "A sleek, themeable SoundCloud desktop client"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "copyright": "Copyright \u00a9 2026 Quantm contributors. GPL-3.0."
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "author": {
    "name": "Quantm"
  }
}
