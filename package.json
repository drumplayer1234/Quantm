{
  "name": "quantm",
  "productName": "Quantm",
  "version": "1.0.2",
  "description": "Quantm",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "license": "GPL-3.0",
  "build": {
    "appId": "app.quantm.desktop",
    "productName": "Quantm",
    "files": [
      "main.js",
      "preload.js",
      "discord.js",
      "src/**/*",
      "build/icon.png",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "appId": "Quantm"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "description": "A sleek, themeable SoundCloud desktop client",
      "maintainer": "drumplayer1234 <54776242+drumplayer1234@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "copyright": "Copyright © 2026 Quantm contributors. GPL-3.0.",
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "releaseInfo": {
      "releaseNotes": "**🚫 No ads**: no audio ads, banners or promoted tracks. Free and open source.\n\n## Which file should I download?\n\n- **Windows:** `Quantm-Setup-<version>.exe` ⭐ **recommended** — installs Quantm with shortcuts and an uninstaller.\n  - `Quantm-<version>-Portable.exe` — runs without installing (starts a little slower).\n- **macOS:** the `.dmg`\n- **Linux:** the `.AppImage` (runs anywhere) or the `.deb` (Debian/Ubuntu)\n\nWindows may show \"Windows protected your PC\" because the installer isn't signed yet: click **More info → Run anyway**."
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "author": {
    "name": "Quantm",
    "email": "54776242+drumplayer1234@users.noreply.github.com",
    "url": "https://github.com/drumplayer1234/Quantm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drumplayer1234/Quantm.git"
  },
  "homepage": "https://github.com/drumplayer1234/Quantm",
  "bugs": {
    "url": "https://github.com/drumplayer1234/Quantm/issues"
  }
}
