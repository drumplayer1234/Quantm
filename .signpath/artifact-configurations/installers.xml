<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers": Quantm-Setup-<version>.exe and
     Quantm-<version>-Portable.exe, built from the already signed app. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
