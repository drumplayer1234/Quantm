<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the unpacked Windows app (dist/win-unpacked).
     Signs Quantm.exe and every other executable/library that ships with it. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="**/*.exe" />
      <include path="**/*.dll" />
      <include path="**/*.node" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
